<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="32dp">

        <ImageView
            android:id="@+id/btnCerrarQuiz"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#757575" />

        <ProgressBar
            android:id="@+id/progressBarQuiz"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#4CAF50"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvPregunta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cargando pregunta..."
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#2D3142"
        android:gravity="center"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btnOpcion1"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="12dp"
        android:text="Opción A"
        android:backgroundTint="#FFFFFF"
        android:textColor="#333333"
        app:cornerRadius="12dp"/>

    <Button
        android:id="@+id/btnOpcion2"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="12dp"
        android:text="Opción B"
        android:backgroundTint="#FFFFFF"
        android:textColor="#333333"
        app:cornerRadius="12dp"/>

    <Button
        android:id="@+id/btnOpcion3"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="12dp"
        android:text="Opción C"
        android:backgroundTint="#FFFFFF"
        android:textColor="#333333"
        app:cornerRadius="12dp"/>

    <Button
        android:id="@+id/btnOpcion4"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="12dp"
        android:text="Opción D"
        android:backgroundTint="#FFFFFF"
        android:textColor="#333333"
        app:cornerRadius="12dp"/>

</LinearLayout>