<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <ImageView
            android:id="@+id/btnCerrarQuiz"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#BDBDBD" />

        <ProgressBar
            android:id="@+id/progressBarQuiz"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:progressDrawable="@drawable/custom_progress_bar"
            android:progress="25"
            android:max="100"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvPreguntaQuiz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_marginTop="20dp"
        android:paddingHorizontal="24dp"
        tools:text="¿Cuál es la traducción de 'The database is connected'?"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#333333"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvPreguntaQuiz"
        android:layout_marginTop="40dp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <Button
            android:id="@+id/btnOpcion1"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            tools:text="La base de datos está conectada"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#4B4B4B"
            android:backgroundTint="#FFFFFF"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="2dp"
            app:cornerRadius="12dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        <Button
            android:id="@+id/btnOpcion2"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            tools:text="El servidor está fallando"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#4B4B4B"
            android:backgroundTint="#FFFFFF"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="2dp"
            app:cornerRadius="12dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        <Button
            android:id="@+id/btnOpcion3"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            tools:text="La red está lenta"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#4B4B4B"
            android:backgroundTint="#FFFFFF"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="2dp"
            app:cornerRadius="12dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        <Button
            android:id="@+id/btnOpcion4"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            tools:text="El cable está desconectado"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#4B4B4B"
            android:backgroundTint="#FFFFFF"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="2dp"
            app:cornerRadius="12dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomZone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:elevation="8dp">

        <Button
            android:id="@+id/btnComprobar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="COMPROBAR"
            android:backgroundTint="#E0E0E0"
            android:textColor="#9E9E9E"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:enabled="false"/>
    </LinearLayout>
</RelativeLayout>